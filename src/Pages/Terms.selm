module Pages.Terms exposing (page)

import Html exposing (Html)
import Html.Attributes as Attr
import Layout

page : Html msg
page =
    Layout.layout
        { title = "Terms of Use"
        , description = "Terms for career.paintbynate.art — content may not be scraped or used to train AI."
        , path = "terms/index.html"
        , type_ = "website"
        }
        (Html.article [ Attr.class "prose terms" ]
            [ Html.h1 [] [ Html.text "Terms of Use" ]
            , Html.node "time" [] [ Html.text "Effective October 20, 2026" ]
            , Html.div [ Attr.class "article-body" ]
                [ Html.p []
                    [ Html.text "This website (career.paintbynate.art and related pages) is a personal portfolio and writing space for Nathan Johnson. It is published for human visitors — people who read, browse, and occasionally get in touch. It is not a free data source for artificial intelligence systems."
                    ]
                , Html.h2 [] [ Html.text "No scraping, crawling, or automated collection" ]
                , Html.p []
                    [ Html.text "You may not use any automated means to access, scrape, crawl, harvest, copy, download, or index this website or its content, except for ordinary search-engine indexing that is not used to train or improve generative AI systems. This includes bots, spiders, scrapers, agents, browser automation, bulk download tools, and any software acting on behalf of an AI or machine-learning system."
                    ]
                , Html.h2 [] [ Html.text "No AI or machine-learning use" ]
                , Html.p []
                    [ Html.text "Without prior written permission from Nathan Johnson, you may not use any content from this site — text, images, code samples, metadata, or structure — to:"
                    ]
                , Html.ul []
                    [ Html.li [] [ Html.text "Train, fine-tune, evaluate, or otherwise improve any AI, machine-learning, or large language model system" ]
                    , Html.li [] [ Html.text "Build or expand retrieval-augmented generation (RAG) corpora, embeddings databases, or similar indexes for generative AI" ]
                    , Html.li [] [ Html.text "Reproduce, summarize, or quote site content in automated AI-generated answers or products offered to third parties" ]
                    , Html.li [] [ Html.text "Include site content in datasets sold, shared, or redistributed for AI development" ]
                    ]
                , Html.p []
                    [ Html.text "These restrictions apply whether or not a crawler respects robots.txt, ai.txt, llms.txt, or HTTP headers. Those files and tags state the site’s preferences; these Terms state the binding rules for anyone who accesses the site."
                    ]
                , Html.h2 [] [ Html.text "What humans may do" ]
                , Html.p []
                    [ Html.text "You are welcome to read the articles, look at the projects, share a link with another person, and quote short passages with attribution for personal, educational, or journalistic purposes that do not involve AI training or automated redistribution. If you want to reuse something more substantial, ask first: "
                    , Html.a [ Attr.href "mailto:nate@paintbynate.art" ] [ Html.text "nate@paintbynate.art" ]
                    , Html.text "."
                    ]
                , Html.h2 [] [ Html.text "Ownership" ]
                , Html.p []
                    [ Html.text "Unless otherwise noted, Nathan Johnson owns the copyright and other rights in the content on this site. Accessing a page does not grant you a license to copy, scrape, or train on that content beyond the limited human uses described above."
                    ]
                , Html.h2 [] [ Html.text "Enforcement" ]
                , Html.p []
                    [ Html.text "Unauthorized scraping or AI use may result in technical blocking, abuse reports to hosting and network providers, and any other remedies available under applicable law, including claims for copyright infringement and violation of these Terms. Continued access after notice of these Terms constitutes acceptance."
                    ]
                , Html.h2 [] [ Html.text "Signals to automated systems" ]
                , Html.p []
                    [ Html.text "This site publishes machine-readable notices that reinforce the same policy:" ]
                , Html.ol []
                    [ Html.li []
                        [ Html.a [ Attr.href "/robots.txt" ] [ Html.text "/robots.txt" ]
                        , Html.text " — known AI training crawlers are disallowed"
                        ]
                    , Html.li []
                        [ Html.a [ Attr.href "/ai.txt" ] [ Html.text "/ai.txt" ]
                        , Html.text " — training and scraping are disallowed"
                        ]
                    , Html.li []
                        [ Html.a [ Attr.href "/llms.txt" ] [ Html.text "/llms.txt" ]
                        , Html.text " — LLM / AI use is refused"
                        ]
                    , Html.li []
                        [ Html.text "HTML meta robots and X-Robots-Tag headers include noai / noimageai where supported"
                        ]
                    ]
                , Html.p []
                    [ Html.text "If you operate a crawler or AI product and believe you have a lawful basis or need an exception, contact "
                    , Html.a [ Attr.href "mailto:nate@paintbynate.art" ] [ Html.text "nate@paintbynate.art" ]
                    , Html.text " before collecting anything. Silence is not consent."
                    ]
                , Html.h2 [] [ Html.text "Changes" ]
                , Html.p []
                    [ Html.text "These Terms may be updated from time to time. The effective date at the top of this page will change when they do. Continued use of the site after an update means you accept the revised Terms."
                    ]
                ]
            ]
        )
