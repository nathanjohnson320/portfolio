module Generated.Styles exposing (css)

{-| Generated by `selm generate_articles`. Do not edit.
-}

css : String
css =
    "/* Portfolio - simple readable stylesheet */\n\n:root {\n  --bg: #f7f6f3;\n  --fg: #1c1917;\n  --muted: #57534e;\n  --border: #d6d3d1;\n  --accent: #0f766e;\n  --surface: #ffffff;\n  --max: 42rem;\n  --wide: 64rem;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  font-size: 17px;\n  -webkit-text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  font-family: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, serif;\n  background: var(--bg);\n  background-image:\n    radial-gradient(ellipse at top left, rgba(15, 118, 110, 0.06), transparent 50%),\n    radial-gradient(ellipse at bottom right, rgba(120, 53, 15, 0.05), transparent 45%);\n  color: var(--fg);\n  line-height: 1.6;\n  min-height: 100vh;\n}\n\na {\n  color: var(--accent);\n  text-decoration-thickness: 1px;\n  text-underline-offset: 0.15em;\n}\n\na:hover {\n  color: #115e59;\n}\n\n.container {\n  width: min(100% - 2rem, var(--wide));\n  margin-inline: auto;\n}\n\n/* Header */\n\n.site-header {\n  border-bottom: 1px solid var(--border);\n  background: color-mix(in srgb, var(--surface) 85%, transparent);\n  backdrop-filter: blur(8px);\n  position: sticky;\n  top: 0;\n  z-index: 10;\n}\n\n.header-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 1rem 0;\n  flex-wrap: wrap;\n}\n\n.site-brand {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-weight: 700;\n  font-size: 1.05rem;\n  letter-spacing: -0.02em;\n  color: var(--fg);\n  text-decoration: none;\n}\n\n.site-nav ul {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.35rem 1rem;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.95rem;\n}\n\n.site-nav a {\n  display: inline-block;\n  padding: 0.35rem 0;\n  color: var(--muted);\n  text-decoration: none;\n}\n\n.site-nav a:hover {\n  color: var(--fg);\n}\n\n.site-main {\n  padding: 1.75rem 0 3rem;\n}\n\n@media (min-width: 640px) {\n  .site-main {\n    padding: 2.5rem 0 4rem;\n  }\n}\n\n.site-footer {\n  border-top: 1px solid var(--border);\n  padding: 1.5rem 0;\n  color: var(--muted);\n  font-size: 0.9rem;\n}\n\n.site-footer a {\n  color: var(--muted);\n}\n\n.site-footer a:hover {\n  color: var(--accent);\n}\n\n.terms .article-body h2 {\n  margin-top: 2rem;\n}\n\n.muted {\n  color: var(--muted);\n  font-size: 0.95rem;\n}\n\n/* Page headings */\n\n.page-heading {\n  max-width: var(--max);\n  margin-bottom: 2.5rem;\n}\n\n.page-heading h1,\n.hero h1 {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: clamp(1.75rem, 4vw, 2.5rem);\n  letter-spacing: -0.03em;\n  line-height: 1.2;\n  margin: 0 0 1rem;\n}\n\n.lede {\n  color: var(--muted);\n  font-size: 1.05rem;\n  margin: 0;\n}\n\n/* Home */\n\n.hero {\n  max-width: var(--max);\n  margin-bottom: 2rem;\n}\n\n.social-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem 1.25rem;\n  list-style: none;\n  margin: 1.5rem 0 0;\n  padding: 0;\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.95rem;\n}\n\n.social-links a {\n  display: inline-block;\n  padding: 0.25rem 0;\n}\n\n.photo-strip {\n  display: flex;\n  gap: 1rem;\n  overflow-x: auto;\n  padding: 1.75rem 0;\n  margin: 0 -1rem 2.5rem;\n  width: calc(100% + 2rem);\n}\n\n.photo-frame {\n  width: 10rem;\n  aspect-ratio: 9 / 10;\n  flex: none;\n  overflow: hidden;\n  border-radius: 0.75rem;\n  background: #e7e5e4;\n  transform: rotate(-2deg);\n  backface-visibility: hidden;\n  -webkit-backface-visibility: hidden;\n}\n\n.photo-frame:nth-child(even) {\n  transform: rotate(2deg);\n}\n\n.photo {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n@media (min-width: 640px) {\n  .photo-frame {\n    width: 14rem;\n    border-radius: 1rem;\n  }\n}\n\n.home-grid {\n  display: grid;\n  gap: 2.5rem;\n}\n\n@media (min-width: 900px) {\n  .home-grid {\n    grid-template-columns: 1fr 18rem;\n    align-items: start;\n  }\n}\n\n.home-articles {\n  display: flex;\n  flex-direction: column;\n  gap: 2rem;\n}\n\n.article-card h2 {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 1.15rem;\n  margin: 0 0 0.35rem;\n}\n\n.article-card h2 a {\n  color: var(--fg);\n  text-decoration: none;\n}\n\n.article-card h2 a:hover {\n  color: var(--accent);\n}\n\n.article-card time {\n  display: block;\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.85rem;\n  color: var(--muted);\n  margin-bottom: 0.5rem;\n}\n\n.article-card p {\n  margin: 0;\n  color: var(--muted);\n}\n\n.read-more {\n  margin-top: 0.5rem !important;\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.9rem;\n}\n\n/* Resume */\n\n.resume {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 0.75rem;\n  padding: 1.25rem;\n}\n\n.resume h2 {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.9rem;\n  margin: 0 0 1rem;\n}\n\n.roles {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.role {\n  display: flex;\n  gap: 0.75rem;\n  align-items: flex-start;\n}\n\n.role-logo {\n  width: 2rem;\n  height: 2rem;\n  border-radius: 999px;\n  object-fit: contain;\n  background: #fff;\n  border: 1px solid var(--border);\n  padding: 2px;\n}\n\n.role-company {\n  display: block;\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.9rem;\n  font-weight: 600;\n}\n\n.role-title,\n.role-dates {\n  display: block;\n  font-size: 0.85rem;\n  color: var(--muted);\n}\n\n.cv-link {\n  margin: 1.25rem 0 0;\n}\n\n.cv-link a {\n  display: block;\n  text-align: center;\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.9rem;\n  padding: 0.6rem;\n  border: 1px solid var(--border);\n  border-radius: 0.5rem;\n  text-decoration: none;\n  color: var(--fg);\n  background: var(--bg);\n}\n\n.cv-link a:hover {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n/* About */\n\n.about {\n  display: grid;\n  gap: 2rem;\n}\n\n@media (min-width: 800px) {\n  .about {\n    grid-template-columns: 16rem 1fr;\n  }\n}\n\n.portrait {\n  width: 100%;\n  max-width: 18rem;\n  aspect-ratio: 1;\n  object-fit: cover;\n  border-radius: 1rem;\n}\n\n.about-copy h1 {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: clamp(1.5rem, 3vw, 2rem);\n  letter-spacing: -0.02em;\n  line-height: 1.25;\n  margin: 0 0 1.25rem;\n}\n\n.about-copy p {\n  color: var(--muted);\n  margin: 0 0 1rem;\n}\n\n.social-list {\n  list-style: none;\n  margin: 2rem 0 0;\n  padding: 0;\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n}\n\n.social-list li {\n  margin-bottom: 0.75rem;\n}\n\n/* Articles list */\n\n.article-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2rem;\n  max-width: var(--max);\n}\n\n/* Article prose */\n\n.prose {\n  max-width: var(--max);\n}\n\n.prose .back {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.9rem;\n  margin-bottom: 1.5rem;\n}\n\n.prose > h1 {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: clamp(1.75rem, 4vw, 2.25rem);\n  letter-spacing: -0.03em;\n  line-height: 1.2;\n  margin: 0 0 0.5rem;\n}\n\n.prose > time {\n  display: block;\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.85rem;\n  color: var(--muted);\n  margin-bottom: 2rem;\n}\n\n.article-body h2,\n.article-body h3,\n.article-body h4 {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  letter-spacing: -0.02em;\n  margin: 2rem 0 0.75rem;\n}\n\n.article-body h4 {\n  font-size: 1.05rem;\n  margin-top: 1.5rem;\n}\n\n.article-body p,\n.article-body li {\n  color: var(--muted);\n}\n\n.article-body a {\n  word-break: break-word;\n}\n\n.article-body img {\n  max-width: 100%;\n  height: auto;\n  border-radius: 0.5rem;\n  margin: 1.25rem 0;\n  border: 1px solid var(--border);\n}\n\n.article-body pre {\n  background: #1c1917;\n  color: #e7e5e4;\n  padding: 1rem;\n  border-radius: 0.5rem;\n  overflow-x: auto;\n  font-size: 0.85rem;\n  line-height: 1.45;\n}\n\n.article-body code {\n  font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;\n  font-size: 0.9em;\n}\n\n.article-body :not(pre) > code {\n  background: color-mix(in srgb, var(--border) 50%, transparent);\n  padding: 0.1em 0.35em;\n  border-radius: 0.25rem;\n}\n\n/* Highlight package tok-* classes (dark pre background) */\n.article-body .tok-kw {\n  color: #fbbf24;\n}\n.article-body .tok-type {\n  color: #67e8f9;\n  font-weight: 600;\n}\n.article-body .tok-ident {\n  color: #e7e5e4;\n}\n.article-body .tok-str {\n  color: #86efac;\n}\n.article-body .tok-num {\n  color: #fdba74;\n}\n.article-body .tok-com {\n  color: #a8a29e;\n  font-style: italic;\n}\n.article-body .tok-op {\n  color: #f0abfc;\n}\n.article-body .tok-punct {\n  color: #d6d3d1;\n}\n\n.article-body ul,\n.article-body ol {\n  padding-left: 1.25rem;\n}\n\n.article-body li > pre {\n  margin-top: 0.75rem;\n}\n\n/* Projects */\n\n.project-grid {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 1.5rem;\n  grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));\n}\n\n.project-card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 0.75rem;\n  padding: 1.25rem;\n}\n\n.project-logo {\n  width: 2.5rem;\n  height: 2.5rem;\n  border-radius: 999px;\n  object-fit: contain;\n  background: #fff;\n  border: 1px solid var(--border);\n  margin-bottom: 1rem;\n}\n\n.project-card h2 {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 1.05rem;\n  margin: 0 0 0.5rem;\n}\n\n.project-card h2 a {\n  color: var(--fg);\n  text-decoration: none;\n}\n\n.project-card h2 a:hover {\n  color: var(--accent);\n}\n\n.project-card p {\n  margin: 0;\n  color: var(--muted);\n  font-size: 0.95rem;\n}\n\n.project-link {\n  margin-top: 1rem !important;\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.85rem;\n  color: var(--muted) !important;\n}\n\n/* Uses */\n\n.uses-sections {\n  display: flex;\n  flex-direction: column;\n  gap: 2.5rem;\n  max-width: var(--max);\n}\n\n.uses-section h2 {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 0.85rem;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--muted);\n  margin: 0 0 1.25rem;\n  padding-bottom: 0.5rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.uses-section ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.tool h3 {\n  font-family: \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n  font-size: 1.05rem;\n  margin: 0 0 0.35rem;\n}\n\n.tool p {\n  margin: 0;\n  color: var(--muted);\n}\n"
