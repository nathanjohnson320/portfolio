-- Helpers

pick : List String -> Random.Seed -> ( String, Random.Seed )
pick options seed =
    case options of
        [] ->
            ( "", seed )

        first :: rest ->
            Random.step (Random.uniform first rest) seed

randomDate : Random.Seed -> ( String, Random.Seed )
randomDate seed0 =
    let
        ( month, seed1 ) =
            pick months seed0

        ( day, seed2 ) =
            Random.step (Random.int 1 28) seed1

        ( yearOffset, seed3 ) =
            Random.step (Random.int 0 4) seed2
    in
    ( month ++ " " ++ String.fromInt day ++ ", " ++ String.fromInt (2022 + yearOffset), seed3 )

randomToken : Random.Seed -> ( String, Random.Seed )
randomToken seed0 =
    let
        alphabet =
            String.toList "abcdefghijklmnopqrstuvwxyz0123456789"

        stepChar s =
            case alphabet of
                [] ->
                    ( 'x', s )

                first :: rest ->
                    Random.step (Random.uniform first rest) s

        ( c1, s1 ) =
            stepChar seed0

        ( c2, s2 ) =
            stepChar s1

        ( c3, s3 ) =
            stepChar s2

        ( c4, s4 ) =
            stepChar s3

        ( c5, s5 ) =
            stepChar s4

        ( c6, s6 ) =
            stepChar s5
    in
    ( String.fromList [ c1, c2, c3, c4, c5, c6 ], s6 )

slugify : String -> String
slugify title =
    title
        |> String.toLower
        |> String.toList
        |> List.filterMap slugChar
        |> String.fromList
        |> collapseDashes
        |> trimDashes
        |> truncateSlug 48

slugChar : Char -> Maybe Char
slugChar ch =
    if Char.isAlphaNum ch then
        Just ch

    else if ch == ' ' || ch == '-' || ch == ':' || ch == ',' || ch == '/' || ch == '.' || ch == '\'' || ch == '"' then
        Just '-'

    else
        Nothing

collapseDashes : String -> String
collapseDashes s =
    if String.contains "--" s then
        collapseDashes (String.replace "--" "-" s)

    else
        s

trimDashes : String -> String
trimDashes s =
    let
        trimmed =
            String.trim s
    in
    if String.startsWith "-" trimmed then
        trimDashes (String.dropLeft 1 trimmed)

    else if String.endsWith "-" trimmed then
        trimDashes (String.dropRight 1 trimmed)

    else
        trimmed

truncateSlug : Int -> String -> String
truncateSlug maxLen s =
    if String.length s <= maxLen then
        s

    else
        trimDashes (String.left maxLen s)
