module Layout exposing (layout, pageHeading)

{-| Shared page chrome: stylesheet, site header, footer, Open Graph, RSS link.
-}

import Html exposing (Html)
import Html.Attributes as Attr
import Html.Document as Doc
import List
import OpenGraph
import SiteMeta

type alias Options =
    { title : String
    , description : String
    , path : String
    , type_ : String
    }

layout : Options -> Html msg -> Html msg
layout opts page =
    let
        pageTitle =
            formatTitle (opts.title)

        ogTitle =
            if opts.title == "" then
                SiteMeta.siteName

            else
                opts.title

        social =
            OpenGraph.tags
                { title = ogTitle
                , description = opts.description
                , url = SiteMeta.absoluteUrl (opts.path)
                , image = Nothing
                , siteName = Just SiteMeta.siteName
                , type_ = opts.type_
                }
    in
    Doc.html []
        [ Doc.head []
            (List.concat
                [ [ Doc.meta [ Attr.charset "utf-8" ] []
                  , Doc.meta
                        [ Attr.name "viewport"
                        , Attr.content "width=device-width, initial-scale=1"
                        ]
                        []
                  , Doc.meta
                        [ Attr.name "robots"
                        , Attr.content "max-image-preview:large, noai, noimageai"
                        ]
                        []
                  , Doc.meta [ Attr.name "googlebot", Attr.content "noai, noimageai" ] []
                  , Doc.meta
                        [ Attr.name "google-extended"
                        , Attr.content "nosnippet, noai"
                        ]
                        []
                  , Doc.meta [ Attr.name "ai", Attr.content "notrain, noindex" ] []
                  ]
                , social
                , [ Doc.link
                        [ Attr.rel "alternate"
                        , Attr.attribute "type" "application/rss+xml"
                        , Attr.title "Nathan Johnson"
                        , Attr.href "/feed.xml"
                        ]
                        []
                  , Doc.link
                        [ Attr.rel "stylesheet", Attr.href "/styles.css" ]
                        []
                  , Doc.link
                        [ Attr.rel "icon", Attr.href "/favicon.ico" ]
                        []
                  , Doc.title [] [ Html.text pageTitle ]
                  ]
                ]
            )
        , Doc.body []
            [ Html.header [ Attr.class "site-header" ]
                [ Html.div [ Attr.class "container header-inner" ]
                    [ Html.a [ Attr.href "/", Attr.class "site-brand" ]
                        [ Html.text "Nathan Johnson" ]
                    , Html.nav [ Attr.class "site-nav" ]
                        [ Html.ul []
                            [ navItem "/about" "About"
                            , navItem "/articles" "Articles"
                            , navItem "/projects" "Projects"
                            , navItem "/uses" "Uses"
                            ]
                        ]
                    ]
                ]
            , Html.main_ [ Attr.class "site-main" ]
                [ Html.div [ Attr.class "container" ] [ page ] ]
            , Html.footer [ Attr.class "site-footer" ]
                [ Html.div [ Attr.class "container" ]
                    [ Html.p []
                        [ Html.text "© Nathan Johnson. "
                        , Html.a [ Attr.href "/" ] [ Html.text "Home" ]
                        , Html.text " · "
                        , Html.a [ Attr.href "/feed.xml" ] [ Html.text "RSS" ]
                        , Html.text " · "
                        , Html.a [ Attr.href "/terms" ] [ Html.text "Terms" ]
                        , Html.text " — content may not be used to train AI."
                        ]
                    ]
                ]
            ]
        ]

formatTitle : String -> String
formatTitle pageTitle =
    if pageTitle == "" then
        "Nathan Johnson"

    else
        pageTitle ++ " - Nathan Johnson"

navItem : String -> String -> Html msg
navItem path label =
    Html.li [] [ Html.a [ Attr.href path ] [ Html.text label ] ]

pageHeading : String -> String -> Html msg
pageHeading heading intro =
    Html.div [ Attr.class "page-heading" ]
        [ Html.h1 [] [ Html.text heading ]
        , Html.p [ Attr.class "lede" ] [ Html.text intro ]
        ]
