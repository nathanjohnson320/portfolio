module Site exposing (files, pages)

{-| Static site page list for `selm export`. Bodies are thunks so pages render one at a time.
-}

import Feed
import Generated.Articles as Articles
import Html exposing (Html)
import List
import Pages.About as About
import Pages.Article as Article
import Pages.Articles as ArticlesPage
import Pages.Home as Home
import Pages.Projects as Projects
import Pages.Terms as Terms
import Pages.Uses as Uses

pages : List { path : String, body : () -> Html msg }
pages =
    let
        articles =
            Articles.all
    in
    List.concat
        [ [ { path = "index.html", body = \_ -> Home.page articles }
          , { path = "about/index.html", body = \_ -> About.page }
          , { path = "articles/index.html", body = \_ -> ArticlesPage.page articles }
          , { path = "projects/index.html", body = \_ -> Projects.page }
          , { path = "uses/index.html", body = \_ -> Uses.page }
          , { path = "terms/index.html", body = \_ -> Terms.page }
          ]
        , List.map
            (\post ->
                { path = "articles/" ++ post.id ++ ".html"
                , body = \_ -> Article.page post
                }
            )
            articles
        ]

{-| Raw text files written beside HTML pages (no document wrapper).
-}
files : List { path : String, body : () -> String }
files =
    [ { path = "feed.xml", body = \_ -> Feed.xml } ]
