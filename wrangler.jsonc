/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2024-07-18",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "career.paintbynate.art",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat"],
  // Required for Workers Builds preview deployments (`npx wrangler preview`).
  // Empty is fine: this Worker is static assets only.
  "previews": {}
}
